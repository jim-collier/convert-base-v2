## Pinned upstream releases of the four big-base reference implementations that
## the interop suite tests against. Nothing here is our code; it is unpacked
## verbatim under thirdparty/ and must stay that way.
##
## One line per package:  NAME|VERSION|URL|SHA256|UPSTREAM
## NAME is the directory under thirdparty/. SHA256 is of the downloaded archive,
## so a refresh that silently pulls different bytes fails instead of landing.
## Bump the version, the URL and the hash in one commit, then rerun
## fetch.bash --refresh to rewrite the manifest from them.
INTEROP_PINS=(
	"base2048-qntm|3.0.0|https://registry.npmjs.org/base2048/-/base2048-3.0.0.tgz|a57d6c9c827e6088e0061458a6386d19a5187f418d02a671bc3e619b41f37c48|github.com/qntm/base2048"
	"base32768-qntm|5.0.1|https://registry.npmjs.org/base32768/-/base32768-5.0.1.tgz|24d570ee914f97f7560f2f69f67ad62a299813ae5aa3fd7bf0895cf08d5bf279|github.com/qntm/base32768"
	"base65536-qntm|5.0.0|https://registry.npmjs.org/base65536/-/base65536-5.0.0.tgz|767627549367aec27666e0d7d7d69d1a4f47c9e754974dfb39d1392e94ef6671|github.com/qntm/base65536"
	"base2048-llfourn|2.0.2|https://crates.io/api/v1/crates/base2048/2.0.2/download|71f4fe417e8cc3bb9b437dfa9290ce92bd2730ba5374719bdfd9147fbc8f17cd|github.com/LLFourn/rust-base2048"
)
