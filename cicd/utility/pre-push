set -Eeuo pipefail

[[ "${CICD_GATE_PASSED:-0}" != "1" ]] || exit 0

zeros="0000000000000000000000000000000000000000"
gated=0
## One line per ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r _ localSha remoteRef _; do
	[[ "${localSha}" != "${zeros}" ]] || continue
	case "${remoteRef}" in refs/heads/dev|refs/heads/main) gated=1 ;; esac
done
((gated)) || exit 0

root="$(git rev-parse --show-toplevel)"
echo "[ pre-push: running the merge gate for dev/main ]"
exec bash "${root}/cicd/cicd.bash" --gate -q </dev/null
