#!/usr/bin/env bash

##	- Purpose: git pre-push hook. Runs the fast merge gate (cicd.bash --gate) when
##	  a push updates dev or main, so nothing reaches either one unchecked. Pushes
##	  to other branches, and deletes, go straight through.
##	- cicd.bash puts a stub in .git/hooks/pre-push that calls this, once per clone.
##	- The gate checks the working tree, so commit or stash stray edits first.
##	- CICD_GATE_PASSED=1 skips it; the pipeline sets that when it publishes, since
##	  it just ran the full tests.

