set -Eeuo pipefail

[[ "${CICD_GATE_PASSED:-0}" != "1" ]] || exit 0

root="$(git rev-parse --show-toplevel)"
# shellcheck source=../config.bash
source "${root}/cicd/config.bash"
[[ -v MERGE_GATE_SKIP ]] || MERGE_GATE_SKIP=()

## Whether every file changed from $1 to $2 matches a MERGE_GATE_SKIP pattern.
fOnlySkippable(){
	local file pat files
	files="$(git diff --name-only "$1" "$2")" || return 1
	while IFS= read -r file; do
		[[ -n "${file}" ]] || continue
		for pat in "${MERGE_GATE_SKIP[@]}"; do
			# shellcheck disable=2053  ## the pattern is meant to glob
			if [[ "${file}" == ${pat} ]]; then continue 2; fi
		done
		return 1
	done <<<"${files}"
	return 0
}

zeros="0000000000000000000000000000000000000000"
gated=0; skipped=0
## One line per ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r _ localSha remoteRef remoteSha; do
	[[ "${localSha}" != "${zeros}" && "${remoteRef}" == refs/heads/main ]] || continue
	## A new main, or one this clone hasn't fetched, can't be compared, so it's gated.
	if [[ "${remoteSha}" != "${zeros}" ]] && git cat-file -e "${remoteSha}^{commit}" 2>/dev/null && fOnlySkippable "${remoteSha}" "${localSha}"; then
		skipped=1
	else
		gated=1
	fi
done
if ((! gated)); then
	if ((skipped)); then echo "[ pre-push: only paths in MERGE_GATE_SKIP changed, so no merge gate for main ]"; fi
	exit 0
fi

echo "[ pre-push: running the merge gate for main ]"
exec bash "${root}/cicd/cicd.bash" --merge-gate -q </dev/null
