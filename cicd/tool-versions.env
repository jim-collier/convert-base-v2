## Pinned versions for the go-installed pipeline tools, so results don't drift
## across machines or over time. One place for both the local pipeline
## (utility/pin-tools.bash brings installs in line) and the workflows under
## .github/workflows (which grep what they need out of this file).
## staticcheck v0.7.0 is the 2026.1 release. nfpm builds the deb/rpm packages
## (cross-arch, no native rpmbuild/dpkg needed) in cicd/utility/package.bash.
GOLANGCI_LINT_VERSION=v2.12.2
STATICCHECK_VERSION=v0.7.0
GOVULNCHECK_VERSION=v1.5.0
NFPM_VERSION=v2.43.0
## goversioninfo writes the icon and version resource for the Windows exes.
GOVERSIONINFO_VERSION=v1.5.0
## shellcheck and ruff come from the system and pipx, not go install, so a
## different version is only reported. A newer one can find new things.
SHELLCHECK_VERSION=0.11.0
RUFF_VERSION=0.15.22
## CodeQL is only ever in the container image, for the leak checks. Its
## checksum is in cicd/container/Dockerfile.
CODEQL_VERSION=2.27.2
