# convert-base-v2 configuration is written in:
#
# SHCL: Simple Hierarchical Config Language.
#
# Forgiving to write, predictable to read. The parser does the work instead of
# you: a typo on one line does not take the rest of the file down with it, and a
# value means what it looks like rather than whatever a type guess makes of it.
#
#	Home     https://github.com/jim-collier/shcl
#	Syntax   https://github.com/jim-collier/shcl/blob/main/project/spec.md
#	License  MIT. Copyright © 2026 Jim Collier.
#
#
# convert-base-v2 creates this file on the first run and never rewritten afterwards,
# so anything you put here is safe. Delete it and it comes back with these defaults.
#
# You can create a system-wide file at '/etc/convert-base-v2/convert-base-v2.shcl'.
# It is read first, so anything here wins over it. Both override the built-in bases:
# reuse a built-in name and your definition replaces it.
#
# Field names are case insensitive, indentation is tabs or spaces, and a value
# only needs quotes when it contains a space, a comma, a colon, a "#", or a
# quote character.
#
#
# Defining a base
#
# Each "base:" line starts one base. The value after the colon is its canonical
# name, and the indented lines under it are its fields.
#
#	aliases    Extra names for the base, comma separated. Optional.
#
#	symbols    The digit symbols, in order. Required. Either one string, split
#	           on whitespace or on commas ("0123456789abcdef", "0 1 2 3"), or a
#	           list with one entry per digit. Use the list form for symbols that
#	           carry a space or a comma of their own.
#
#	negative   Marker for a negative number. Defaults to "-".
#	decimal    Marker for the fractional point. Defaults to ".".
#
#	pad        RFC style padding character. Applies in binary mode only, and
#	           only to a power-of-2 base of at most 256 symbols, which is the
#	           only place padding is ever written. Anywhere else it is an error
#	           rather than a silent no-op. Decoding strips a trailing run of it.
#	pademit    Set false for padding that is accepted on input but never
#	           written.
#
#	tail       Secondary symbols for the final digit of a byte stream. Only for
#	           a base of more than 256 symbols. See below.
#
# Leaving a marker field empty turns that feature off on purpose:
#
#	negative:
#
# The defaults "-" and "." are an error when they are also digits of the base,
# so such a base has to either name different markers or switch them off. That
# is deliberate: a silently disabled sign is worse than a refused definition.
#
#
# About tail
#
# A base with more than 256 symbols packs more than eight bits into a digit, so
# the last digit of a byte stream is usually only partly filled. The tail is a
# second, smaller set of symbols used for that final digit alone, which is how
# the decoder knows how many real bits it carries. Without one the encoder has
# to write a length count up front, which it cannot know until it has read all
# the input, so nothing streams and nothing large can be encoded at all.
#
# A tail must hold a power of 2 symbols, at least two, at least 2^(bits-8) of
# them (four for a 1024 symbol base, eight for 2048), no more than 256, and none
# of them may also be a digit. Anything else is an error where it is written.


# Base 10 in emoji, hand picked to carry a wide range of expressions. It lives
# here rather than in the built-in set, so there is always a working example to
# copy from.
base: emoji10
	symbols: "😀 😑 😔 😘 😜 😠 😬 😮 🙄 🤔"
	negative: "🥕"
	decimal: "⚽"


# Everything below is commented out. Uncomment a block to try it.

# A toy base 4.
#base: abcd
#	aliases: 4abc
#	symbols: ABCD

# A base whose digits include "-", so the default negative marker would collide.
#base: u12
#	symbols: "0123456789-_"
#	negative: N

# List form: one entry per digit.
#base: emoji4
#	symbols: 🍎, 🍊, 🍋, 🍌

# The same list stacked one per line, which reads better when there are many.
#base: fruit4
#	symbols:
#		* 🍎
#		* 🍊
#		* 🍋
#		* 🍌

# A 512 symbol base with a tail, so binary mode streams both ways. Nine bits per
# digit, so the tail needs 2^(9-8) = 2 symbols, and neither may be a digit. The
# alphabet is left as a placeholder because 512 symbols is a long line.
#base: cjk512
#	symbols: "<512 symbols, whitespace delimited>"
#	tail: ⸐, ⸑
